{
  "name": "admin-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bundle": "node scripts/inline.js",
    "encrypt": "staticrypt bundled.html --password BCT1234 -d docs --short --template scripts/staticrypt-template.html && mv docs/bundled.html docs/index.html",
    "export": "vite build && node scripts/fix-script-tags.js && cp vite-out/index.html docs/index.html"
  },
  "dependencies": {
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.8",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
